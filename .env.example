# Copy file này thành .env rồi điền giá trị thật: cp .env.example .env

# PostgreSQL
POSTGRES_DB=todo
POSTGRES_USER=todo
POSTGRES_PASSWORD=change-me

# JWT - chuỗi ngẫu nhiên dài ít nhất 32 ký tự (vd: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# URL người dùng mở trên trình duyệt, dùng để tạo link đặt lại mật khẩu trong email
APP_FRONTEND_URL=http://localhost

# Đăng nhập có bắt nhập OTP gửi qua email không (MFA)
# false -> đăng nhập chỉ cần email + mật khẩu
LOGIN_OTP_ENABLED=true

# Email (SMTP)
# MAIL_ENABLED=false -> không gửi mail, chỉ in nội dung email (OTP, link reset) ra log của container api
MAIL_ENABLED=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=your-email@example.com
